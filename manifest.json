  "news": [
    {
      "date": "2026-11-16",
      "title": "Custom OverlordsXI Launcher Icon & Branding (v1.0.9)",
      "body": "Added a custom high-contrast OverlordsXI gold & cyan crystal emblem for OverlordsLauncher.exe, the taskbar, title bar, and hero banner."
    },
    {
      "date": "2026-11-16",
      "title": "Kazenoeye Server-Synced Debuff Timers (v1.0.8)",
      "body": "kazenoeye now pulls active mob status effects and exact remaining durations directly from the OverlordsXI server (0x1FE OXKE sync) so timers are always real and never guessed."
    },
    {
      "date": "2026-11-16",
      "title": "QOL Addons Included: Mob Levels & Mob Debuff HUD",
      "body": "The launcher now includes checker (exact monster level on /check), mobdb (target mob level range, aggro & weaknesses), and kazenoeye (floating HP bar and debuff icons/timers above mob models) by default."
    },
    {
      "date": "2026-11-14",
      "title": "Scholar Call Eos & Call Titania Companions",
      "body": "Summon Eos (Medic Light Arts) or Titania (Sage Dark Arts enfeebling & nuking dark fairy) via crystal unlocks, and switch crystals with !spec."
    },
    {
      "date": "2026-11-14",
      "title": "OverlordsXI Launcher & Auto-Updater",
      "body": "Distributable Ashita v4 launcher with automatic DAT overlay (Pivot) and overlords_talents addon syncing, FFXI install detection, and graphics configuration."
    },
    {
      "date": "2026-11-13",
      "title": "192 Bespoke 4-Tier Weaponskill Talent Trees",
      "body": "Use /talents (or /tal) in-game with the Ashita addon loaded, or !talent without the addon, to customize all 207 player weaponskills."
    }
  ]
